module Parse_new where

type Byte   = [8]
type Word16 = [16]
type Ret    = [32]

type Chunk  = [3]Byte
type Cands  = [384]Word16
type OkBits = [384][8]
type Prefix = [385]Word16
type Poly   = [256]Word16

q : Word16
q = 3329

retSuccess : Ret
retSuccess = 0

retKeyLenError : Ret
retKeyLenError = ((-1) : [32])

parseD1 : Chunk -> Word16
parseD1 [b0, b1, _] =
  (zero # b0) + ((zero # (b1 % (16 : [8]))) << 8)

parseD2 : Chunk -> Word16
parseD2 [_, b1, b2] =
  ((zero # b1) >> 4) + ((zero # b2) << 4)

usableBytes : [578]Byte -> [576]Byte
usableBytes bytes = take`{576} bytes

chunksOfInput : [578]Byte -> [192]Chunk
chunksOfInput bytes = split (usableBytes bytes)

candPair : Chunk -> [2]Word16
candPair bs = [parseD1 bs, parseD2 bs]

collectCandidates : [578]Byte -> Cands
collectCandidates bytes = join (map candPair (chunksOfInput bytes))

okByte : Word16 -> [8]
okByte d =
  if d < q
  then (1 : [8])
  else (0 : [8])

collectOk : Cands -> OkBits
collectOk cand = map okByte cand

prefixStep : Word16 -> [8] -> Word16
prefixStep acc okb = acc + (zero # okb)

buildPrefix : OkBits -> Prefix
buildPrefix ok = scanl prefixStep 0 ok

type CandOkPref = (Word16, ([8], Word16))

prefixTail : Prefix -> [384]Word16
prefixTail pref = drop`{1} pref

zippedTriples : Cands -> OkBits -> Prefix -> [384]CandOkPref
zippedTriples cand ok pref = zip cand (zip ok (prefixTail pref))

pickOne : Word16 -> CandOkPref -> Word16
pickOne rank (c, (okb, prefv)) =
  if (okb != (0 : [8])) /\ (prefv == rank)
  then c
  else 0

selectByRank : Cands -> OkBits -> Prefix -> Word16 -> Word16
selectByRank cand ok pref rank =
  sum chosen
  where
    chosen : [384]Word16
    chosen = map (pickOne rank) (zippedTriples cand ok pref)

ranks : [256]Word16
ranks = [1 .. 256 : Word16]

buildOutput : Cands -> OkBits -> Prefix -> Poly
buildOutput cand ok pref =
  map (selectByRank cand ok pref) ranks

parse_578_256 : [578]Byte -> (Ret, Poly)
parse_578_256 bytes =
  if validCount < (256 : [16])
  then (retKeyLenError, zero)
  else (retSuccess, out)
  where
    cand : Cands
    cand = collectCandidates bytes

    ok : OkBits
    ok = collectOk cand

    pref : Prefix
    pref = buildPrefix ok

    validCount : Word16
    validCount = last pref

    out : Poly
    out = buildOutput cand ok pref

zeroInput578 : [578]Byte
zeroInput578 = zero

/* 测试 1：全 0 输入时，validCount 应该是 384 */
prop_zero_validCount : Bit
property prop_zero_validCount =
  validCount == (384 : [16])
  where
    cand : Cands
    cand = collectCandidates zeroInput578

    ok : OkBits
    ok = collectOk cand

    pref : Prefix
    pref = buildPrefix ok

    validCount : Word16
    validCount = last pref

/* 测试 2：全 0 输入时，Parse 应成功返回 */
prop_zero_parse_success : Bit
property prop_zero_parse_success =
  result == (retSuccess, zero)
  where
    result : (Ret, Poly)
    result = parse_578_256 zeroInput578

/* 测试 3：输出长度固定为 256，每个系数都是 0 */
prop_zero_output_all_zero : Bit
property prop_zero_output_all_zero =
  out == zero
  where
    (_, out) = parse_578_256 zeroInput578