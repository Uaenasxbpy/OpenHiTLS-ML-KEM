/* 分配一块 LLVM 内存，并用给定值初始化 */
let alloc_init ty v = do {
  p <- llvm_alloc ty;
  llvm_points_to p v;
  return p;
};

/* 加载 bitcode 和 Cryptol 规格 */
m <- llvm_load_module "parse.bc";
import "Parse.cry";

/* 固定实例：Parse(poly, bytes, 578, 256) */
let parse_spec_578_256 = do {
  /* 符号输入：578 字节 */
  bytes <- llvm_fresh_var "bytes" (llvm_array 578 (llvm_int 8));

  /* 输出数组：256 个 uint16，初始全 0 */
  poly_arr <- alloc_init (llvm_array 256 (llvm_int 16))
                         (llvm_term {{ zero : [256][16] }});

  /* 输入数组：578 个 uint8 */
  bytes_arr <- alloc_init (llvm_array 578 (llvm_int 8))
                          (llvm_term bytes);

  /* 执行 C 函数：
       int32_t Parse(uint16_t *polyNtt, const uint8_t *arrayB,
                     uint32_t arrayLen, uint32_t n)
  */
  llvm_execute_func [
    poly_arr,
    bytes_arr,
    llvm_term {{ 578 : [32] }},
    llvm_term {{ 256 : [32] }}
  ];

  /* 输入数组是只读的，调用后不变 */
  llvm_points_to bytes_arr (llvm_term bytes);

  /* 用包装后的 Cryptol 规格计算期望结果 */
  let parse_result = {{ parse_578_256 bytes : ([32], [256][16]) }};

  /* 检查输出数组 */
  llvm_points_to poly_arr (llvm_term {{ parse_result.1 }});

  /* 检查返回值 */
  llvm_return (llvm_term {{ parse_result.0 }});
};

/* 发起验证 */
llvm_verify m "Parse" [] false parse_spec_578_256 z3;