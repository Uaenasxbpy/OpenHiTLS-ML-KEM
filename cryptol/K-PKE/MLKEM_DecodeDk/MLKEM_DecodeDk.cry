module MLKEM_DecodeDk where

import ml_kem_pke::En_Decode::Encode_Decode
import K_PKE::MLKEM_DecodeEk::MLKEM_DecodeEk // 导入上一步写好的 EK 解码模块

// ==========================================
// 1. 常量与类型
// ==========================================
type MLKEM_N = 256
type Byte = [8]
type K = 3 
type CIPHER_LEN = 384 

// EK 长度 = (384 * K) + 32
type EK_LEN = CIPHER_LEN * K + 32

// DK 长度 = (Encoded S) + (EK)
// Encoded S = 384 * K
// Total DK = 2 * (384 * K) + 32
type DK_LEN = (CIPHER_LEN * K) + EK_LEN

// ==========================================
// 2. 辅助函数 (复用)
// ==========================================
to_16bit : [MLKEM_N][12] -> [MLKEM_N][16]
to_16bit poly = [ zext c | c <- poly ]

// ==========================================
// 3. MLKEM_DecodeDk 核心逻辑
// ==========================================
// 输入: dk 字节串
// 输出: (Vector S, Matrix A, Vector T)
// 注意: C 代码实际上填充了 ctx->keyData 的三个部分

MLKEM_DecodeDk : [DK_LEN]Byte -> ([K][MLKEM_N][16], [K][K][MLKEM_N][16], [K][MLKEM_N][16])
MLKEM_DecodeDk dk = (vectorS, matrixA, vectorT)
  where
    // ---------------------------------------------------------
    // 1. 拆分 dk
    // dk 布局: [ encoded_s (384*K bytes) | ek (...) ]
    // ---------------------------------------------------------
    
    // 取前部: packed s
    encoded_s_bytes : [K * CIPHER_LEN]Byte
    encoded_s_bytes = take`{K * CIPHER_LEN} dk

    // 取后部: ek
    ek_bytes : [EK_LEN]Byte
    ek_bytes = drop`{K * CIPHER_LEN} dk

    // ---------------------------------------------------------
    // 2. 重建向量 s
    // C代码: 循环调用 DecodeBits12
    // ---------------------------------------------------------
    s_chunks : [K][CIPHER_LEN]Byte
    s_chunks = split encoded_s_bytes

    vectorS = [ to_16bit (DecodeBits12 chunk) | chunk <- s_chunks ]

    // ---------------------------------------------------------
    // 3. 重建 ek 部分 (Matrix A 和 Vector T)
    // C代码: 调用 MLKEM_DecodeEk(ekBuff)
    // ---------------------------------------------------------
    // 这里直接利用 Cryptol 的函数复用特性
    (matrixA, vectorT) = MLKEM_DecodeEk ek_bytes

// ==========================================
// 4. 属性验证
// ==========================================

// 验证 DecodeDk 是否正确解析了包含在内的 ek
property prop_DecodeDk_Contains_Ek (dk : [DK_LEN]Byte) =
    (mA_dk == mA_ek) /\ (vT_dk == vT_ek)
    where
       // 通过 DecodeDk 解析
       (_, mA_dk, vT_dk) = MLKEM_DecodeDk dk
       
       // 手动提取 ek 并通过 DecodeEk 解析
       ek_part = drop`{K * CIPHER_LEN} dk
       (mA_ek, vT_ek) = MLKEM_DecodeEk ek_part