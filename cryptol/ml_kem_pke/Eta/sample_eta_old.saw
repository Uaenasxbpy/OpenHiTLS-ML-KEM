enable_experimental;
import "SamplePolyCBD.cry";
import "NTT.cry";
import "SampleEta.cry";

let MLKEM_N = 256;
let K = 3;       
let ETA1 = 2;
let PRF_LEN_1 = 128; 


// CBD 函数规范 (对应 eta=2)
let cbd_spec = do {
    polyF_ptr <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
    buf <- llvm_fresh_var "cbd_buf" (llvm_array PRF_LEN_1 (llvm_int 8));
    buf_ptr <- llvm_alloc (llvm_array PRF_LEN_1 (llvm_int 8));
    llvm_points_to buf_ptr (llvm_term buf);
    let eta = llvm_term {{ `ETA1:[8] }};
    llvm_execute_func [polyF_ptr, buf_ptr, eta];
    llvm_points_to polyF_ptr (llvm_term {{ sample_poly_cbd`{eta=2} buf }});
};

// NTT 函数规范
let ntt_spec = do {
    a <- llvm_fresh_var "ntt_in" (llvm_array MLKEM_N (llvm_int 16));
    a_ptr <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
    llvm_points_to a_ptr (llvm_term a);
    psi <- llvm_fresh_var "psi" (llvm_array MLKEM_N (llvm_int 16));
    psi_ptr <- llvm_alloc_readonly (llvm_array MLKEM_N (llvm_int 16));
    llvm_points_to psi_ptr (llvm_term psi);
    llvm_execute_func [a_ptr, psi_ptr];
    llvm_points_to a_ptr (llvm_term {{ ntt_spec a psi }});
};

// 4. SampleEta1 主验证脚本
let sample_eta1_spec_proof = do {
    info_ptr <- llvm_alloc_readonly (llvm_struct "struct.MLKEM_Info");
    llvm_points_to info_ptr (llvm_struct_value [ llvm_term {{ `K:[8] }}, llvm_term {{ `ETA1:[8] }}, llvm_term {{ 2:[8] }} ]);

    ctx_ptr <- llvm_alloc_readonly (llvm_struct "struct.CRYPT_ML_KEM_Ctx");
    let null_ptr = llvm_null; // libCtx 为空
    llvm_points_to ctx_ptr (llvm_struct_value [ null_ptr, info_ptr ]);

    digest_ptr <- llvm_alloc_readonly (llvm_array 32 (llvm_int 8));
    digest <- llvm_fresh_var "digest" (llvm_array 32 (llvm_int 8));
    llvm_points_to digest_ptr (llvm_term digest);

    polyS_ptr <- llvm_alloc (llvm_array K (llvm_pointer (llvm_int 16)));

    p0 <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
    p1 <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
    p2 <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
    llvm_points_to polyS_ptr (llvm_array_value [p0, p1, p2]);

    nonce_ptr <- llvm_alloc (llvm_int 8);
    let nonce_val = {{ 0:[8] }}; 
    llvm_points_to nonce_ptr (llvm_term nonce_val);

    rand_rows <- llvm_fresh_var "rand_rows" (llvm_array K (llvm_array PRF_LEN_1 (llvm_int 8)));

    llvm_alloc_global "MOCK_PRF_DATA";
    let mock_data_ptr = llvm_global "MOCK_PRF_DATA";

    let flat_rand_data = {{ join rand_rows }};
    
    let mock_data_full = {{ flat_rand_data # zero : [1024][8] }};
    llvm_points_to mock_data_ptr (llvm_term mock_data_full);

    psi_mem <- llvm_alloc_readonly (llvm_array MLKEM_N (llvm_int 16));
    psi <- llvm_fresh_var "psi" (llvm_array MLKEM_N (llvm_int 16));
    llvm_points_to psi_mem (llvm_term psi);

    llvm_alloc_global "PRE_COMPUT_TABLE_NTT_MONT";
    llvm_points_to (llvm_global "PRE_COMPUT_TABLE_NTT_MONT") psi_mem;

    llvm_execute_func [ctx_ptr, digest_ptr, polyS_ptr, nonce_ptr];

    llvm_points_to nonce_ptr (llvm_term {{ nonce_val + `K }});
    let expected_polys = {{ sample_eta1_spec rand_rows psi }};
    llvm_points_to p0 (llvm_term {{ expected_polys @ 0 }});
    llvm_points_to p1 (llvm_term {{ expected_polys @ 1 }});
    llvm_points_to p2 (llvm_term {{ expected_polys @ 2 }});
    llvm_return (llvm_term {{ 0:[32] }});
};

print "Loading module...";
m <- llvm_load_module "sample_eta.bc";
print "Assuming MLKEM_SamplePolyCBD spec...";
cbd_ov <- llvm_unsafe_assume_spec m "MLKEM_SamplePolyCBD" cbd_spec;

print "Assuming MLKEM_ComputNTT spec...";
ntt_ov <- llvm_unsafe_assume_spec m "MLKEM_ComputNTT" ntt_spec;

print "Verifying SampleEta1...";
llvm_verify m "SampleEta1" [cbd_ov, ntt_ov] true sample_eta1_spec_proof z3;

print "Done.";