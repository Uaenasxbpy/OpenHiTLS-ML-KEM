module NTT where

// ==========================================
// 1. 常量定义
// ==========================================

type MLKEM_N = 256
type MLKEM_N_T = 256

// Q 定义为 32 位，以适应 Montgomery 运算的需求
MLKEM_Q : [32]
MLKEM_Q = 3329

MLKEM_Q_INV_BETA : [16]
MLKEM_Q_INV_BETA = -3327

V : [16]
V = 20159

ROUNDING_C : [32]
ROUNDING_C = (1 << 25)

// 辅助：符号扩展
sext : {n, m} (fin n, fin m, m >= n) => [n] -> [m]
sext x = (repeat (x @ 0)) # x

// ==========================================
// 2. 核心约简函数
// ==========================================

barrett_reduction : [16] -> [16]
barrett_reduction a = ret
  where
    a_32 = sext a : [32]
    v_32 = sext V : [32]
    numerator = (v_32 * a_32) + ROUNDING_C
    t_32 = numerator >>$ 26
    t = drop t_32 : [16]
    
    // 【修正点】将 32位的 MLKEM_Q 截断为 16位 参与计算
    // 因为 t 是 [16]，所以必须乘以 [16]
    t_q = t * (drop MLKEM_Q : [16])
    
    ret = a - t_q

montgomery_reduction : [32] -> [16]
montgomery_reduction a = ret
  where
    a_low = drop a : [16]
    
    // 这里 MLKEM_Q_INV_BETA 本身就是 [16]，所以没问题
    t = a_low * MLKEM_Q_INV_BETA
    t_32 = sext t : [32]
    
    // 这里需要 [32] 的 Q，直接用全局变量即可
    sub_res = a - (t_32 * MLKEM_Q)
    shifted = sub_res >>$ 16
    ret = drop shifted

// ==========================================
// 3. NTT 蝴蝶运算 (Butterfly)
// ==========================================

ntt_butterfly : [MLKEM_N][16] -> [32] -> [32] -> [16] -> [MLKEM_N][16]
ntt_butterfly poly j len zeta = poly_new
  where
    aj     = poly @ j
    aj_len = poly @ (j + len)
    
    prod = (sext aj_len : [32]) * (sext zeta : [32])
    t = montgomery_reduction prod
    
    val_len_new = aj - t
    val_j_new   = aj + t
    
    poly_tmp = update poly (j + len) val_len_new
    poly_new = update poly_tmp j val_j_new

// ==========================================
// 4. 递归模拟 C 循环
// ==========================================

// 内层循环递归
ntt_block_recursive : [32] -> [32] -> [32] -> [16] -> [MLKEM_N][16] -> [MLKEM_N][16]
ntt_block_recursive j count len zeta poly = 
  if count == 0 then poly
  else ntt_block_recursive (j + 1) (count - 1) len zeta new_poly
    where
      new_poly = ntt_butterfly poly j len zeta

// 中间层循环递归
process_layer : [MLKEM_N][16] -> [32] -> [32] -> [32] -> [MLKEM_N][16] -> ([MLKEM_N][16], [32])
process_layer poly k len start psi = 
  if start >= `MLKEM_N then (poly, k)
  else process_layer new_poly (k + 1) len (start + 2 * len) psi
    where
       zeta = psi @ k
       new_poly = ntt_block_recursive start len len zeta poly

// ==========================================
// 5. 最外层循环 (Outer Loop)
// ==========================================

type State = ([MLKEM_N][16], [32])

ntt_iter : [MLKEM_N][16] -> [MLKEM_N][16] -> [MLKEM_N][16]
ntt_iter poly_in psi = final_poly
  where
    init_state = (poly_in, 1)
    
    lens = [128, 64, 32, 16, 8, 4, 2] : [7][32]
    
    step : State -> [32] -> State
    step (p, k) len = process_layer p k len 0 psi
    
    (poly_transformed, _) = foldl step init_state lens
    
    final_poly = [ barrett_reduction x | x <- poly_transformed ]

// ==========================================
// 6. 顶层规范接口
// ==========================================

ntt_spec : [MLKEM_N][16] -> [MLKEM_N][16] -> [MLKEM_N][16]
ntt_spec a psi = ntt_iter a psi