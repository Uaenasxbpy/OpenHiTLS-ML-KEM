enable_experimental;
import "MontgomeryReduction.cry";
import "BarrettReduction.cry";
import "MLKEM_ComputNTT.cry"; 
m <- llvm_load_module "ntt.bc";
let MLKEM_N = 256;
let mont_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ montgomery_reduction a }});
};
let barrett_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 16);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ barrett_reduction a }});
};
print "Verifying MontgomeryReduction...";
mont_ov <- llvm_verify m "MontgomeryReduction" [] true mont_spec z3;
print "Verifying BarrettReduction...";
barrett_ov <- llvm_verify m "BarrettReduction" [] true barrett_spec z3;

let ntt_spec = do {
    a <- llvm_fresh_var "a" (llvm_array MLKEM_N (llvm_int 16));
    a_ptr <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
    llvm_points_to a_ptr (llvm_term a);
    psi_ptr <- llvm_alloc_readonly (llvm_array 129 (llvm_int 16));
    llvm_points_to psi_ptr (llvm_term {{ psi_table }});
    llvm_execute_func [a_ptr, psi_ptr];
    
    let res = {{ mlkem_computNTT a psi_table }};
    llvm_points_to a_ptr (llvm_term res);
};

print "Verifying MLKEM_ComputNTT using overrides...";
llvm_verify m "MLKEM_ComputNTT" [mont_ov, barrett_ov] false ntt_spec w4_abc_verilog;

print "Done.";