enable_experimental;

import "SamplePolyCBD.cry";
import "MLKEM_ComputNTT.cry";
import "SampleEta.cry";
import "../hash/hash.cry"; 
m <- llvm_load_module "sample_eta.bc";

let MLKEM_N   = 256;
let K         = 3;
let ETA1      = 2;
let ETA2      = 2;
let SEED_LEN  = 32;
let IN_LEN    = 33;    
let PRF_LEN_1 = 128;
let PRF_LEN_2 = 128;

// 定义常用的指针类型别名
let i8p  = llvm_pointer (llvm_int 8);
let i16p = llvm_pointer (llvm_int 16);

let prf_havoc_eta1 = do {
  ctx_t <- llvm_fresh_var "ctx" (llvm_int 64);

  in_ptr <- llvm_alloc_readonly (llvm_array IN_LEN (llvm_int 8));
  in_val <- llvm_fresh_var "in_val" (llvm_array IN_LEN (llvm_int 8));
  llvm_points_to in_ptr (llvm_term in_val);

  out_ptr <- llvm_alloc (llvm_array PRF_LEN_1 (llvm_int 8));

  llvm_execute_func
    [ llvm_term ctx_t
    , in_ptr
    , llvm_term {{ `IN_LEN:[64] }}
    , out_ptr
    , llvm_term {{ `PRF_LEN_1:[64] }}
    ];

  out_val <- llvm_fresh_var "out_havoc" (llvm_array PRF_LEN_1 (llvm_int 8));
  llvm_points_to out_ptr (llvm_term out_val);

  llvm_return (llvm_term {{ 0:[32] }});
};

// --- PRF (Eta2) ---
let prf_havoc_eta2 = do {
  ctx_t   <- llvm_fresh_var "ctx" (llvm_int 64);

  in_ptr  <- llvm_alloc_readonly (llvm_array IN_LEN (llvm_int 8));
  in_val  <- llvm_fresh_var "in_val" (llvm_array IN_LEN (llvm_int 8));
  llvm_points_to in_ptr (llvm_term in_val);

  out_ptr <- llvm_alloc (llvm_array PRF_LEN_2 (llvm_int 8));

  llvm_execute_func
    [ llvm_term ctx_t
    , in_ptr
    , llvm_term {{ `IN_LEN:[64] }}
    , out_ptr
    , llvm_term {{ `PRF_LEN_2:[64] }}
    ];

  out_val <- llvm_fresh_var "out_havoc" (llvm_array PRF_LEN_2 (llvm_int 8));
  llvm_points_to out_ptr (llvm_term out_val);

  llvm_return (llvm_term {{ 0:[32] }});
};

// --- CBD (Eta1) ---
let cbd_havoc_eta1 = do {
  poly_ptr <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
  
  buf_ptr  <- llvm_alloc_readonly (llvm_array PRF_LEN_1 (llvm_int 8));
  buf_val  <- llvm_fresh_var "buf_val" (llvm_array PRF_LEN_1 (llvm_int 8));
  llvm_points_to buf_ptr (llvm_term buf_val);

  llvm_execute_func 
    [ poly_ptr
    , buf_ptr
    , llvm_term {{ `ETA1:[8] }} 
    ];

  poly_val <- llvm_fresh_var "poly_havoc" (llvm_array MLKEM_N (llvm_int 16));
  llvm_points_to poly_ptr (llvm_term poly_val);

};

// --- CBD (Eta2) ---
let cbd_havoc_eta2 = do {
  poly_ptr <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
  
  buf_ptr  <- llvm_alloc_readonly (llvm_array PRF_LEN_2 (llvm_int 8));
  buf_val  <- llvm_fresh_var "buf_val" (llvm_array PRF_LEN_2 (llvm_int 8));
  llvm_points_to buf_ptr (llvm_term buf_val);

  llvm_execute_func 
    [ poly_ptr
    , buf_ptr
    , llvm_term {{ `ETA2:[8] }} 
    ];

  poly_val <- llvm_fresh_var "poly_havoc" (llvm_array MLKEM_N (llvm_int 16));
  llvm_points_to poly_ptr (llvm_term poly_val);

  // [Fix] Void 函数不需要 return
};

// --- NTT ---
let ntt_havoc = do {
  a_ptr <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
  a_in  <- llvm_fresh_var "a_in" (llvm_array MLKEM_N (llvm_int 16));
  llvm_points_to a_ptr (llvm_term a_in);

  psi_ptr <- llvm_alloc_readonly (llvm_array 129 (llvm_int 16));
  // 必须指向 psi_table 以匹配 C 代码中的全局读取
  llvm_points_to psi_ptr (llvm_term {{ psi_table }});

  llvm_execute_func [ a_ptr, psi_ptr ];

  a_out <- llvm_fresh_var "a_out_havoc" (llvm_array MLKEM_N (llvm_int 16));
  llvm_points_to a_ptr (llvm_term a_out);

};


let info_type = llvm_struct_type [
    llvm_int 8, llvm_int 8, llvm_int 8, llvm_int 8, llvm_int 8, 
    llvm_int 32, llvm_int 32, llvm_int 32, llvm_int 32, llvm_int 32, llvm_int 32
];

let ctx_type = llvm_struct_type [
    llvm_int 32,                
    llvm_pointer info_type,     
    llvm_pointer (llvm_int 8),  
    llvm_int 32,                
    llvm_pointer (llvm_int 8),  
    llvm_int 32,                
    llvm_pointer (llvm_int 8)   
];

let sample_eta1_glue = do {
  // ---- info ----
  info_ptr <- llvm_alloc_readonly info_type;
  llvm_points_to info_ptr
    (llvm_struct_value
      [ llvm_term {{ `K:[8] }}
      , llvm_term {{ `ETA1:[8] }}
      , llvm_term {{ `ETA2:[8] }}
      , llvm_term {{ 0:[8] }}, llvm_term {{ 0:[8] }}
      , llvm_term {{ 0:[32] }}, llvm_term {{ 0:[32] }}, llvm_term {{ 0:[32] }} 
      , llvm_term {{ 0:[32] }}, llvm_term {{ 0:[32] }}, llvm_term {{ 0:[32] }}
      ]);

  // ---- ctx ----
  ctx_ptr <- llvm_alloc_readonly ctx_type;
  llvm_points_to ctx_ptr (llvm_struct_value 
      [ llvm_term {{ 0:[32] }} 
      , info_ptr               
      , llvm_null, llvm_term {{ 0:[32] }} 
      , llvm_null, llvm_term {{ 0:[32] }} 
      , llvm_null              
      ]);

  // ---- digest ----
  digest_ptr <- llvm_alloc_readonly (llvm_array SEED_LEN (llvm_int 8));
  digest <- llvm_fresh_var "digest" (llvm_array SEED_LEN (llvm_int 8));
  llvm_points_to digest_ptr (llvm_term digest);

  // ---- polyS ----
  polyS_ptr <- llvm_alloc (llvm_array K (llvm_pointer (llvm_int 16)));
  p0 <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
  p1 <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
  p2 <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
  llvm_points_to polyS_ptr (llvm_array_value [p0, p1, p2]);

  // ---- nonce ----
  nonce_ptr <- llvm_alloc (llvm_int 8);
  let start_nonce = {{ 0:[8] }};
  llvm_points_to nonce_ptr (llvm_term start_nonce);
  
  // ---- Global ----
  psi_mem <- llvm_alloc_readonly (llvm_array 129 (llvm_int 16));
  llvm_points_to psi_mem (llvm_term {{ psi_table }});
  llvm_alloc_global "PRE_COMPUT_TABLE_NTT_MONT";
  llvm_points_to (llvm_global "PRE_COMPUT_TABLE_NTT_MONT") psi_mem;

  // ---- execute ----
  llvm_execute_func [ctx_ptr, digest_ptr, polyS_ptr, nonce_ptr];

  // ---- verify ----
  llvm_points_to nonce_ptr (llvm_term {{ start_nonce + `K }});

  llvm_return (llvm_term {{ 0:[32] }});
};

let sample_eta2_glue = do {
  // ---- info (ETA2) ----
  info_ptr <- llvm_alloc_readonly info_type;
  llvm_points_to info_ptr
    (llvm_struct_value
      [ llvm_term {{ `K:[8] }}
      , llvm_term {{ `ETA1:[8] }}
      , llvm_term {{ `ETA2:[8] }}
      , llvm_term {{ 0:[8] }}, llvm_term {{ 0:[8] }}
      , llvm_term {{ 0:[32] }}, llvm_term {{ 0:[32] }}, llvm_term {{ 0:[32] }} 
      , llvm_term {{ 0:[32] }}, llvm_term {{ 0:[32] }}, llvm_term {{ 0:[32] }}
      ]);

  // ---- ctx ----
  ctx_ptr <- llvm_alloc_readonly ctx_type;
  llvm_points_to ctx_ptr (llvm_struct_value 
      [ llvm_term {{ 0:[32] }}, info_ptr, llvm_null, llvm_term {{ 0:[32] }}, llvm_null, llvm_term {{ 0:[32] }}, llvm_null ]);

  digest_ptr <- llvm_alloc_readonly (llvm_array SEED_LEN (llvm_int 8));
  digest <- llvm_fresh_var "digest" (llvm_array SEED_LEN (llvm_int 8));
  llvm_points_to digest_ptr (llvm_term digest);

  polyS_ptr <- llvm_alloc (llvm_array K (llvm_pointer (llvm_int 16)));
  p0 <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
  p1 <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
  p2 <- llvm_alloc (llvm_array MLKEM_N (llvm_int 16));
  llvm_points_to polyS_ptr (llvm_array_value [p0, p1, p2]);

  nonce_ptr <- llvm_alloc (llvm_int 8);
  let start_nonce = {{ 0:[8] }};
  llvm_points_to nonce_ptr (llvm_term start_nonce);

  // ---- execute ----
  llvm_execute_func [ctx_ptr, digest_ptr, polyS_ptr, nonce_ptr];

  // ---- verify ----
  llvm_points_to nonce_ptr (llvm_term {{ start_nonce + `K }});

  llvm_return (llvm_term {{ 0:[32] }});
};

// 4. Run Verification
print "Registering overrides...";
prf_ov1 <- llvm_unsafe_assume_spec m "PRF"                 prf_havoc_eta1;
prf_ov2 <- llvm_unsafe_assume_spec m "PRF"                 prf_havoc_eta2;
cbd_ov1 <- llvm_unsafe_assume_spec m "MLKEM_SamplePolyCBD" cbd_havoc_eta1;
cbd_ov2 <- llvm_unsafe_assume_spec m "MLKEM_SamplePolyCBD" cbd_havoc_eta2;
ntt_ov  <- llvm_unsafe_assume_spec m "MLKEM_ComputNTT"     ntt_havoc;

print "Verifying SampleEta1...";
llvm_verify m "SampleEta1" [prf_ov1, cbd_ov1, ntt_ov] true sample_eta1_glue w4_abc_verilog;

print "Verifying SampleEta2...";
llvm_verify m "SampleEta2" [prf_ov2, cbd_ov2] true sample_eta2_glue w4_abc_verilog;

print "Done.";