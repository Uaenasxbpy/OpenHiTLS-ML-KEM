module ml_kem_pke::GenMatrix::GenMatrix where

import ml_kem_pke::hash::hash

type MLKEM_N = 256
type XOF_LEN = 578
type Q = 3329
type Byte = [8]

// ==========================================
// 1. 辅助函数：3字节 -> 2个16位
// ==========================================
// 输入: [b0, b1, b2]
// 输出: [d1, d2] (类型为 [16]，高4位补0)
BytesToUint12 : [3]Byte -> [2][16]
BytesToUint12 [b0, b1, b2] = [d1, d2]
  where
    // split 将 b1 拆分为 高4位(hi) 和 低4位(lo)
    [hi, lo] = (split b1) : [2][4]
    
    // d1 = b0 + (lo << 8)
    d1 = (zext b0) + ((zext lo) << 8)
    
    // d2 = hi + (b2 << 4)
    d2 = (zext hi) + ((zext b2) << 4)

// ==========================================
// 2. 修复后的 Parse_Spec
// ==========================================
Parse_Spec : [XOF_LEN]Byte -> [MLKEM_N][16]
Parse_Spec bytes = output
  where
    // 1. 切分: 578字节 -> 取前576字节 -> 192个3字节块
    // (578 - 576 = 2，最后2字节按标准被丢弃)
    blocks : [192][3]Byte
    blocks = split (take`{576} bytes)

    // 2. 转换: 192块 -> 384个候选数
    candidates : [384][16]
    candidates = join [ BytesToUint12 b | b <- blocks ]

    // 3. 过滤 (使用 foldl 替代循环)
    // 状态机: (当前已收集个数, 当前输出数组)
    // 逻辑: 遍历所有候选数，如果数 < Q 且 没填满，就填入数组
    step : ([16], [MLKEM_N][16]) -> [16] -> ([16], [MLKEM_N][16])
    step (count, acc) x = 
      if (x < `Q) && (count < `MLKEM_N)
         then (count + 1, update acc count x) // 填入 x，计数+1
         else (count, acc)                    // 保持不变

    // 执行折叠，初始状态 count=0, acc全0
    (_, output) = foldl step (0, zero) candidates


// ==========================================
// 3. GenMatrix Spec
// ==========================================
// 记得保留 k>=1 的约束
gen_matrix : {k} (fin k, k >= 1, width (k-1) <= 8) => [32][8] -> Bit -> [k][k][MLKEM_N][16]
gen_matrix digest isEnc = matrix
  where
    matrix = [ [ row i j | j <- [0 .. <k] ] | i <- [0 .. <k] ]
    
    row i j = poly
      where
        idx1 = if isEnc then (i:[8]) else (j:[8])
        idx2 = if isEnc then (j:[8]) else (i:[8])
        
        seed = digest # [idx1, idx2]
        
        xof_out = HashFuncXOF`{outLen=XOF_LEN} seed
        
        poly = Parse_Spec xof_out

// ==========================================
// 4. Properties (验证模型属性) - 全面改为 where
// ==========================================

// Property 1: 确定性
prop_Deterministic : [32][8] -> Bit -> Bit
property prop_Deterministic seed isEnc =
    gen_matrix`{k=3} seed isEnc == gen_matrix`{k=3} seed isEnc

// Property 2: 值域检查 (All < Q)
prop_RangeValid : [32][8] -> Bit -> Bit
property prop_RangeValid seed isEnc =
    all (\row -> 
         all (\poly -> 
           all (\coeff -> coeff < `Q) poly
         ) row
       ) matrix
  where
    matrix = gen_matrix`{k=3} seed isEnc

// Property 3: 转置关系 (核心逻辑)
// 验证 A[i][j] 的种子 == A'[j][i] 的种子
prop_TransposeRelation : [32][8] -> Bit
property prop_TransposeRelation seed =
    mat_enc == transpose mat_gen
  where
    mat_enc = gen_matrix`{k=3} seed True
    mat_gen = gen_matrix`{k=3} seed False

// Property 4: 参数 k 的适应性测试
property prop_Transpose_K2 seed =
    mat_enc == transpose mat_gen
  where
    mat_enc = gen_matrix`{k=2} seed True
    mat_gen = gen_matrix`{k=2} seed False

property prop_Transpose_K4 seed =
    mat_enc == transpose mat_gen
  where
    mat_enc = gen_matrix`{k=4} seed True
    mat_gen = gen_matrix`{k=4} seed False