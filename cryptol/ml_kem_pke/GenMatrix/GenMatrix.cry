module GenMatrix where
// 2 => ML-KEM-512
// 3 => ML-KEM-768
// 4 => ML-KEM-1024
type k = 3
type MLKEM_N = 256
type MLKEM_Q = 3329
type MLKEM_SEED_LEN = 32
type MLKEM_XOF_OUTPUT_LENGTH = 1000

// 类型别名
type Byte = [8]
type UInt12 = [12]
type Poly = [MLKEM_N]UInt12
type Matrix = [k][k]Poly
type Seed = [MLKEM_SEED_LEN]Byte

/* * 2. 外部依赖 (Mock/Abstract)
 */
hashFuncXOF : [MLKEM_SEED_LEN + 2]Byte -> [MLKEM_XOF_OUTPUT_LENGTH]Byte
hashFuncXOF input = zero

// 从3个字节中提取两个 12-bit 候选值
extract_d1 : [3]Byte -> UInt12
extract_d1 [b0, b1, _] = (zext b0) + ((zext (b1 && 0x0f)) << 8)

extract_d2 : [3]Byte -> UInt12
extract_d2 [_, b1, b2] = ((zext b1) >> 4) + ((zext b2) << 4)

// 检查系数是否有效 (< Q)
is_valid_coeff : UInt12 -> Bit
is_valid_coeff c = c < `MLKEM_Q

// 定义 Parse 的中间状态
type ParseState = {
    cnt : [9],
    poly : Poly
}

// 状态更新函数
parse_step : ParseState -> UInt12 -> ParseState
parse_step st c = 
    if is_valid_coeff c && (st.cnt < `MLKEM_N) then
        { cnt = st.cnt + 1
        , poly = update st.poly st.cnt c
        }
    else 
        st

parse : [MLKEM_XOF_OUTPUT_LENGTH]Byte -> Poly
parse bytes = final_state.poly
  where
    chunks = split (take`{999} bytes) : [333][3]Byte
    candidates = [ c | chunk <- chunks, c <- [extract_d1 chunk, extract_d2 chunk] ]
    initial_state = { cnt = 0, poly = zero }
    final_state = foldl parse_step initial_state candidates

genMatrix : Seed -> Bit -> Matrix
genMatrix digest isEnc = 
    [ [ generate_poly r c | c <- [0 .. k-1] ] | r <- [0 .. k-1] ]
    where
        generate_poly : [8] -> [8] -> Poly
        generate_poly i j = parse xofOut
            where
                (idx1, idx2) = if isEnc then (i, j) else (j, i)
                p = digest # [idx1, idx2]
                xofOut = hashFuncXOF p



// 性质 1: 范围约束 (Range Check)
property prop_vals_bound seed isEnc =
    all (\x -> x < `MLKEM_Q) all_coeffs
    where 
        mat = genMatrix seed isEnc
        // join 将 [k][k]Poly 展平为 [k*k]Poly
        // 再 join 一次展平为 [k*k*256]UInt12
        all_coeffs = join (join mat)

// 性质 2: 转置关系 (Transpose Relation)
property prop_transpose_relation seed =
    mat_enc == transpose mat_no_enc
    where
        mat_enc    = genMatrix seed True
        mat_no_enc = genMatrix seed False

// 性质 3: 零值行为测试 (Sanity Check for Mock)
property prop_mock_zero_behavior seed isEnc =
    (genMatrix seed isEnc) == zero

// 性质 4: Parse 逻辑单元测试
property prop_parse_logic_check =
    (parse input_stream) @ 0 == 0
    where
        // 构造 1000 字节，前 3 字节产生一个非法值(4095)和一个有效值(0)
        input_stream = [0xFF, 0x0F, 0x00] # (zero : [997][8])